# ===========================================
# CONFIGURATION DE L'APPLICATION
# ===========================================

# ===========================================
# BASE DE DONNEES (PostgreSQL)
# ===========================================
DB_URL=jdbc:postgresql://localhost:5432/projetimmobilier
DB_USERNAME=postgres
DB_PASSWORD=votre_mot_de_passe

# ===========================================
# SECURITE - JWT
# ===========================================
JWT_SECRET=votre-cle-jwt-tres-secrete-et-longue-pour-securiser-les-tokens
JWT_EXPIRATION=86400000

# ===========================================
# EMAIL - BREVO (SENDINBLUE)
# ===========================================
BREVO_API_KEY=votre-api-key-brevo

# ===========================================
# FRONTEND URL
# IMPORTANT: Pour les emails d'invitation agent
# Si vous utilisez ngrok ou un domaine personnalisé
# ===========================================
# Localhost (par defaut - ne fonctionne que sur l'ordinateur local)
FRONTEND_URL=http://localhost:3000

# Pour acces depuis telephone sur le meme reseau
# Remplacez 192.168.1.100 par votre IP locale
# FRONTEND_URL=http://192.168.1.100:3000

# Pour ngrok (temporaire)
# FRONTEND_URL=https://votre-url-ngrok.ngrok-free.app

# Pour production
# FRONTEND_URL=https://votre-domaine.com

# ===========================================
# CORS - ORIGINES AUTORISEES
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# SECURITE HTTPS (en production)
# ===========================================
REQUIRE_HTTPS=false
