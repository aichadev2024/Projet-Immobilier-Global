# ===============================
# 🔐 SÉCURITÉ - JWT
# ===============================
# Générez une clé secrète de 256+ caractères pour la production
JWT_SECRET=256-bit-secret-key-that-must-be-at-least-256-bits-long-for-hs256-algorithm-but-change-this-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ===============================
# 🗄️ BASE DE DONNÉES
# ===============================
DB_URL=jdbc:postgresql://localhost:5432/projet_immobilier
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ===============================
# 🌐 CORS & SÉCURITÉ
# ===============================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
REQUIRE_HTTPS=false

# ===============================
# 🔒 SSL (PRODUCTION)
# ===============================
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# ===============================
# 📧 BREVO EMAIL
# ===============================
BREVO_API_KEY=your_brevo_api_key_here

# ===============================
# 📊 LOGGING
# ===============================
SPRING_PROFILES_ACTIVE=dev

# ===============================
# 🔧 SÉCURITÉ COMPLÉMENTAIRE
# ===============================
# Rate limiting, etc.
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=30
